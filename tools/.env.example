# ── Paperless-ngx ─────────────────────────────────────────────
PAPERLESS_URL=http://paperless:8000
PAPERLESS_TOKEN=put-your-api-token-here
# Custom field that holds the author. Name (default) or numeric id.
PAPERLESS_AUTHOR_FIELD=document_author
# Only export these document types (comma separated, case-insensitive). Empty = export everything.
PUBLIC_DOCUMENT_TYPES=Ordinance,Resolution

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=smart-sb-storage
# Optional: only for EU / FedRAMP jurisdiction buckets
# R2_ENDPOINT_URL=https://<account>.eu.r2.cloudflarestorage.com
# Public base URL of the bucket (custom domain or r2.dev URL) - used to build the links in documents.json
R2_PUBLIC_BASE_URL=https://files.example.org
